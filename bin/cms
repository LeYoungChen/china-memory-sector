#!/usr/bin/env bash
# 存储芯片板块分析 —— 统一入口（任何 Agent 都可直接调用）
# 用法: cms <fetch|summary|excel|report|check|all|setup> <workdir> [YYYY-MM-DD]
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$SKILL_DIR/.venv"
PY="$VENV/bin/python"
S="$SKILL_DIR/scripts"

setup() {
  if [ ! -x "$PY" ] || ! "$PY" -c "import akshare,openpyxl,docx,matplotlib,formulas" 2>/dev/null; then
    echo "[cms] 首次运行，正在创建 Python 环境（约 1–2 分钟）..." >&2
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --disable-pip-version-check -r "$SKILL_DIR/requirements.txt"
  fi
}

usage() { sed -n '2,3p' "$0"; exit 1; }
CMD="${1:-}"; [ -z "$CMD" ] && usage
if [ "$CMD" = "setup" ]; then setup; echo "[cms] 环境就绪"; exit 0; fi
WD="${2:-}"; [ -z "$WD" ] && usage
mkdir -p "$WD"; WD="$(cd "$WD" && pwd)"
setup

DATA="$WD/data/dataset.json"
asof() { "$PY" -c "import json;print(json.load(open('$DATA'))['as_of'])"; }
need() { [ -f "$1" ] || { echo "[cms] 缺少 $1 —— $2" >&2; exit 2; }; }

case "$CMD" in
  fetch)
    "$PY" "$S/fetch_data.py" --universe "${UNIVERSE:-$SKILL_DIR/references/universe.csv}" \
      --out "$WD/data" --asof "${3:-$(date +%F)}" ;;
  summary)
    need "$DATA" "先运行 cms fetch"; "$PY" "$S/summarize.py" --data "$DATA" ;;
  excel)
    need "$DATA" "先运行 cms fetch"; X="$WD/存储芯片板块_$(asof).xlsx"
    "$PY" "$S/build_excel.py" --data "$DATA" --industry "$WD/industry.json" --out "$X"
    "$PY" "$S/check_excel.py" "$X" ;;
  report)
    need "$DATA" "先运行 cms fetch"; need "$WD/analysis.json" "先按 references/report-outline.md 撰写中文分析"
    "$PY" "$S/build_report.py" --data "$DATA" --analysis "$WD/analysis.json" \
      --industry "$WD/industry.json" --out "$WD/存储芯片板块_$(asof).docx" ;;
  check)
    "$PY" "$S/check_excel.py" "$WD/存储芯片板块_$(asof).xlsx" ;;
  all)
    "$0" excel "$WD" && "$0" report "$WD" ;;
  *) usage ;;
esac
